{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catchm-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  // Per-PR previews: <alias>-catchm-web.<subdomain>.workers.dev
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // The Worker sees every request first so it can add X-Robots-Tag on
    // non-production hosts (static assets can't branch on the host).
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "catchm.spacingmind.com", "custom_domain": true }]
}
